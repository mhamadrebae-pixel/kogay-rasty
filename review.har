            "size": -1,
            "mimeType": "text/html; charset=utf-8",
            "text": "<!DOCTYPE html>\n<!--  index.html  -->\n<html lang=\"ku\" dir=\"rtl\">\n \n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"mobile-web-app-capable\" content=\"yes\">\n    <title>کۆگای ڕاستی</title>\n    <!-- ★ v=1 گۆڕ هەر جارێک style.css گۆڕی → v=2, v=3, ... -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800;900&display=swap\"\n        rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\">\n    <!-- جیاتی v=1, v=2 -->\n    <link rel=\"stylesheet\" href=\"style.css?v=2026040902\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"./icon-192.png\">\n    <link rel=\"apple-touch-icon\" href=\"./icon-192.png\">\n    <link rel=\"manifest\" href=\"manifest.json?v=2026040902\">\n    <meta name=\"description\" content=\"کۆگای ڕاستی — باشترین کاڵاکان بەنرخی گونجاو\">\n    <!-- Open Graph / Social Share -->\n    <meta property=\"og:title\" content=\"کۆگای ڕاستی\">\n    <meta property=\"og:description\" content=\"باشترین کاڵاکان هەڵبژێرە و داواکاریەکەت بنێرە\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:image\" content=\"./icon-512.png\">\n    <meta property=\"og:locale\" content=\"ku\">\n    <meta name=\"twitter:card\" content=\"summary\">\n    <meta name=\"twitter:title\" content=\"کۆگای ڕاستی\">\n    <meta name=\"twitter:image\" content=\"./icon-512.png\">\n    <meta name=\"theme-color\" content=\"#f97316\">\n    <script src=\"analytics.js?v=2026041001\" defer></script>\n    <script src=\"script.js?v=2026041001\" defer></script>\n</head>\n \n<body>\n \n    <!-- Background -->\n    <div class=\"bg-container\">\n        <div class=\"gradient-bg\"></div>\n        <div class=\"floating-shapes\">\n            <div class=\"shape shape-1\"></div>\n            <div class=\"shape shape-2\"></div>\n            <div class=\"shape shape-3\"></div>\n        </div>\n    </div>\n \n    <!-- Loading -->\n    <div class=\"loader\" id=\"loader\">\n        <div class=\"loader-content\">\n            <div class=\"loader-icon\"><i class=\"fas fa-store\"></i></div>\n            <div class=\"loader-text\">کۆگای ڕاستی</div>\n            <div class=\"loader-bar\">\n                <div class=\"loader-progress\"></div>\n            </div>\n        </div>\n    </div>\n \n    <!-- Navbar -->\n    <nav class=\"navbar\" id=\"navbar\">\n        <div class=\"nav-container\">\n            <div class=\"logo\">\n                <div class=\"logo-icon\"><i class=\"fas fa-store\"></i></div>\n                <div class=\"logo-text\">\n                    <span class=\"logo-title\" id=\"logoTitle\">کۆگای ڕاستی</span>\n                    <span class=\"logo-subtitle\" id=\"logoSubtitle\">فرۆشگای تایبەت</span>\n                </div>\n            </div>\n            <div class=\"nav-search\">\n                <i class=\"fas fa-search\"></i>\n                <input type=\"text\" id=\"searchInput\" placeholder=\"گەڕان...\">\n            </div>\n            <button class=\"cart-btn\" type=\"button\" onclick=\"toggleCart()\" aria-label=\"Open cart\">\n                <i class=\"fas fa-shopping-cart\"></i>\n                <span class=\"cart-text\">سەبەتە</span>\n                <span class=\"cart-count\" id=\"cartCount\">0</span>\n            </button>\n            <div class=\"lang-switcher\">\n                <button class=\"lang-btn active\" data-lang=\"ku\" type=\"button\" onclick=\"setLang('ku')\">KU</button>\n                <button class=\"lang-btn\" data-lang=\"en\" type=\"button\" onclick=\"setLang('en')\">EN</button>\n            </div>\n            <button class=\"theme-btn\" type=\"button\" onclick=\"toggleTheme()\" title=\"Dark/Light\" aria-label=\"Toggle theme\">\n                <i class=\"fas fa-moon\"></i>\n            </button>\n        </div>\n    </nav>\n \n    <!-- گەڕانی موبایل -->\n    <div class=\"mobile-search\">\n        <div class=\"mobile-search-inner\">\n            <i class=\"fas fa-search\"></i>\n            <input type=\"text\" id=\"searchInputMobile\" placeholder=\"گەڕان لە کاڵاکان...\">\n        </div>\n    </div>\n\n    <div class=\"offline-banner\" id=\"offlineBanner\" aria-live=\"polite\" aria-hidden=\"true\">\n        <div class=\"offline-banner-inner\">\n            <i class=\"fas fa-wifi-slash\"></i>\n            <span id=\"offlineBannerText\">ئۆفلاینیت، بەرهەمە هەڵگیراوەکان نیشان دەدرێن</span>\n        </div>\n    </div>\n\n    <main class=\"site-main\">\n    <!-- Hero -->\n    <section class=\"hero\">\n        <div class=\"hero-content\">\n            <div class=\"hero-badge\">\n                <i class=\"fas fa-star\"></i>\n                <span>باشترین کوالیتی</span>\n            </div>\n            <h1 class=\"hero-title\">\n                <span class=\"title-line\">کۆگای</span>\n                <span class=\"title-highlight\">ڕاستی</span>\n            </h1>\n            <p class=\"hero-subtitle\">باشترین کاڵاکان هەڵبژێرە و داواکاریەکەت بنێرە</p>\n            <div class=\"hero-stats\">\n                <div class=\"stat-item\">\n                    <span class=\"stat-number\">400+</span>\n                    <span class=\"stat-label\">بەرهەم</span>\n                </div>\n                <div class=\"stat-divider\"></div>\n                <div class=\"stat-item\">\n                    <span class=\"stat-number\">6</span>\n                    <span class=\"stat-label\">بەش</span>\n                </div>\n                <div class=\"stat-divider\"></div>\n                <div class=\"stat-item\">\n                    <span class=\"stat-number\">24/7</span>\n                    <span class=\"stat-label\">خزمەت</span>\n                </div>\n            </div>\n        </div>\n        <div class=\"hero-decoration\">\n            <div class=\"floating-card card-1\"><i class=\"fas fa-cake-candles\"></i><span>کێک</span></div>\n            <div class=\"floating-card card-2\"><i class=\"fas fa-cookie-bite\"></i><span>گەز</span></div>\n            <div class=\"floating-card card-3\"><i class=\"fas fa-bowl-food\"></i><span>چیپس</span></div>\n        </div>\n    </section>\n \n    <!-- Categories -->\n    <section class=\"categories-section\">\n        <div class=\"section-header\">\n            <h2 class=\"section-title\"><i class=\"fas fa-border-all\"></i> <span id=\"sectionCatsTitle\">بەشەکان</span></h2>\n            <button class=\"wishlist-filter-btn\" id=\"wishlistFilterBtn\" type=\"button\" onclick=\"toggleWishlistFilter()\" title=\"دڵخوازەکان\" aria-label=\"Toggle favorites\">\n                <i class=\"fas fa-heart\"></i>\n            </button>\n        </div>\n        <div class=\"categories-container\" id=\"categoriesContainer\">\n            <button class=\"category-card active\" data-category=\"cake\" onclick=\"showCategory('cake', this)\">\n                <div class=\"category-icon\"><i class=\"fas fa-cake-candles\"></i></div>\n                <div class=\"category-info\">\n                    <span class=\"category-name\">کێک</span>\n                    <span class=\"category-count\">0 کاڵا</span>\n                </div>\n            </button>\n            <button class=\"category-card\" data-category=\"gaz\" onclick=\"showCategory('gaz', this)\">\n                <div class=\"category-icon\"><i class=\"fas fa-cookie-bite\"></i></div>\n                <div class=\"category-info\">\n                    <span class=\"category-name\">گەز و بسکیت</span>\n                    <span class=\"category-count\">0 کاڵا</span>\n                </div>\n            </button>\n            <button class=\"category-card\" data-category=\"drink\" onclick=\"showCategory('drink', this)\">\n                <div class=\"category-icon\"><i class=\"fas fa-glass-water\"></i></div>\n                <div class=\"category-info\">\n                    <span class=\"category-name\">خواردنەوە</span>\n                    <span class=\"category-count\">0 کاڵا</span>\n                </div>\n            </button>\n            <button class=\"category-card\" data-category=\"chips\" onclick=\"showCategory('chips', this)\">\n                <div class=\"category-icon\"><i class=\"fas fa-bowl-food\"></i></div>\n                <div class=\"category-info\">\n                    <span class=\"category-name\">چیپس</span>\n                    <span class=\"category-count\">0 کاڵا</span>\n                </div>\n            </button>\n            <button class=\"category-card\" data-category=\"baby\" onclick=\"showCategory('baby', this)\">\n                <div class=\"category-icon\"><i class=\"fas fa-baby\"></i></div>\n                <div class=\"category-info\">\n                    <span class=\"category-name\">مناڵان</span>\n                    <span class=\"category-count\">0 کاڵا</span>\n                </div>\n            </button>\n            <button class=\"category-card\" data-category=\"family\" onclick=\"showCategory('family', this)\">\n                <div class=\"category-icon\"><i class=\"fas fa-users\"></i></div>\n                <div class=\"category-info\">\n                    <span class=\"category-name\">عایلەی</span>\n                    <span class=\"category-count\">0 کاڵا</span>\n                </div>\n            </button>\n        </div>\n    </section>\n \n    <!-- Products -->\n    <section class=\"products-section\">\n        <div class=\"section-header\">\n            <h2 class=\"section-title\" id=\"categoryTitle\"><i class=\"fas fa-cake-candles\"></i> کێک</h2>\n            <span class=\"products-count\" id=\"productsCount\">0 کاڵا</span>\n        </div>\n        <div class=\"products-grid\" id=\"productsGrid\"></div>\n        <div class=\"pagination-wrap\" id=\"paginationWrap\" style=\"display:none;\"></div>\n        <div class=\"empty-state\" id=\"emptyState\" style=\"display:none;\">\n            <div class=\"empty-icon\"><i class=\"fas fa-box-open\"></i></div>\n            <h3>هیچ کاڵایەک نەدۆزرایەوە</h3>\n            <p>هەوڵ بدە بە گەڕانی دیکە</p>\n        </div>\n    </section>\n    </main>\n \n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-content\">\n            <div class=\"footer-logo\">\n                <div class=\"footer-icon\"><i class=\"fas fa-store\"></i></div>\n                <span id=\"footerBrand\">کۆگای ڕاستی</span>\n            </div>\n            <p class=\"footer-text\" id=\"footerText\">© 2026 کۆگای ڕاستی — هەموو مافەکان پارێزراون بۆ</p>\n\n            <div class=\"developer-card\">\n                <div class=\"developer-card-icon\"><i class=\"fas fa-code\"></i></div>\n                <div class=\"developer-card-text\">\n                    <span class=\"developer-label\" id=\"developerLabel\">دیزاین و گەشەپێدراوە لەلایەن</span>\n                    <strong class=\"developer-name\">Mhamad</strong>\n                </div>\n                <a class=\"profile-btn\" id=\"profileBtn\" href=\"https://mhamadrebae-pixel.github.io/my-profile/\" target=\"_blank\" rel=\"noopener\">\n                    <i class=\"fas fa-user\"></i>\n                    <span>View profile</span>\n                </a>\n            </div>\n\n            <div class=\"footer-social\">\n                <a href=\"https://www.facebook.com/share/1DetrL6pvc/?mibextid=wwXIfr\" target=\"_blank\" class=\"social-link\"\n                    title=\"Facebook\"><i class=\"fab fa-facebook\"></i></a>\n                <a href=\"https://wa.me/9647518959614\" target=\"_blank\" class=\"social-link\" title=\"WhatsApp\"><i\n                        class=\"fab fa-whatsapp\"></i></a>\n                <a href=\"tel:+9647518959614\" class=\"social-link\" title=\"Phone\"><i class=\"fas fa-phone\"></i></a>\n            </div>\n            <p class=\"footer-phone\">\n                <i class=\"fas fa-phone\"></i>\n                <a href=\"tel:+9647518959614\">+964 751 895 9614</a>\n            </p>\n        </div>\n    </footer>\n\n    <!-- Cart -->\n    <div class=\"cart-overlay\" id=\"cartOverlay\" onclick=\"toggleCart()\"></div>\n    <aside class=\"cart-sidebar\" id=\"cartSidebar\">\n        <div class=\"cart-header\">\n            <div class=\"cart-title\">\n                <div class=\"cart-title-icon\"><i class=\"fas fa-shopping-bag\"></i></div>\n                <div>\n                    <h3>سەبەتە</h3>\n                    <span id=\"cartItemsCount\">0 کاڵا</span>\n                </div>\n            </div>\n            <button class=\"close-btn\" type=\"button\" onclick=\"toggleCart()\" aria-label=\"Close cart\"><i class=\"fas fa-times\"></i></button>\n        </div>\n        <div class=\"cart-items\" id=\"cartItems\">\n            <div class=\"cart-empty\">\n                <div class=\"empty-cart-icon\"><i class=\"fas fa-shopping-cart\"></i></div>\n                <h4>سەبەتە بەتاڵە</h4>\n                <p>کاڵای دڵخوازت زیاد بکە</p>\n            </div>\n        </div>\n        <div class=\"cart-footer\">\n            <div class=\"cart-summary\">\n                <div class=\"summary-row\">\n                    <span>کۆی کاڵاکان:</span>\n                    <span id=\"totalItems\">0</span>\n                </div>\n                <div class=\"summary-row total\">\n                    <span>کۆی گشتی:</span>\n                    <span class=\"total-amount\" id=\"totalPrice\">0 IQD</span>\n                </div>\n            </div>\n            <div class=\"customer-form\">\n                <h4><i class=\"fas fa-user\"></i> زانیاری کڕیار</h4>\n                <div class=\"form-group\">\n                    <input type=\"text\" id=\"customerName\" placeholder=\"ناوت بنووسە...\">\n                    <i class=\"fas fa-user input-icon\"></i>\n                </div>\n                <div class=\"form-group\">\n                    <input type=\"tel\" id=\"customerPhone\" placeholder=\"ژمارە تەلەفۆن...\">\n                    <i class=\"fas fa-phone input-icon\"></i>\n                </div>\n            </div>\n            <button class=\"checkout-btn\" onclick=\"sendWhatsApp()\">\n                <i class=\"fab fa-whatsapp\"></i>\n                <span>ناردن بە WhatsApp</span>\n            </button>\n        </div>\n    </aside>\n \n    <!-- مۆدالی سوپاس -->\n    <div class=\"success-modal\" id=\"successModal\">\n        <div class=\"success-modal-box\">\n            <div class=\"success-icon\"><i class=\"fab fa-whatsapp\"></i></div>\n            <h3 id=\"successModalTitle\">سوپاس! 🎉</h3>\n            <p id=\"successModalText\">داواکاریەکەت بە سەرکەوتوویی نێردرا<br>بەم زووانەیە پەیوەندیت پێوە دەکرێت</p>\n            <button class=\"success-close-btn\" id=\"successModalCloseBtn\" type=\"button\" onclick=\"closeSuccessModal()\">باشە، سوپاس!</button>\n        </div>\n    </div>\n \n    <!-- PWA Install Banner -->\n    <div class=\"install-banner\" id=\"installBanner\" style=\"display:none;\">\n        <div class=\"install-banner-inner\">\n            <div class=\"install-banner-icon\"><i class=\"fas fa-store\"></i></div>\n            <div class=\"install-banner-text\">\n                <span id=\"installBannerTitle\">ئەپەکە دامەزرێنە</span>\n                <small id=\"installBannerSub\">خێراتر و ئاسانتر بەکاربێنە</small>\n            </div>\n            <button class=\"install-banner-btn\" id=\"installBtn\" type=\"button\" onclick=\"triggerInstall()\" aria-label=\"Install app\">\n                <i class=\"fas fa-download\"></i>\n            </button>\n            <button class=\"install-banner-close\" type=\"button\" onclick=\"dismissInstall()\" aria-label=\"Close install banner\">✕</button>\n        </div>\n    </div>\n\n    <!-- Toast -->\n    <div class=\"toast-container\" id=\"toastContainer\"></div>\n \n    <!-- Scroll Top -->\n    <button class=\"scroll-top\" id=\"scrollTop\" type=\"button\" onclick=\"scrollToTop()\" aria-label=\"Scroll to top\">\n        <i class=\"fas fa-arrow-up\"></i>\n    </button>\n \n    <!-- ★ Service Worker دامەزراندن -->\n    <script>\n        if ('serviceWorker' in navigator) {\n            window.addEventListener('load', () => {\n                navigator.serviceWorker.register('./sw.js?v=2026040902')\n                    .then(reg => {\n                        console.log('[SW] Registered:', reg.scope);\n                        reg.addEventListener('updatefound', () => {\n                            console.log('[SW] Update found');\n                        });\n                    })\n                    .catch(err => console.warn('[SW] Registration failed:', err));\n            });\n        }\n    </script>\n \n</body>\n \n</html>\n"
