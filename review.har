          "content": {
            "size": -1,
            "mimeType": "text/css; charset=utf-8",
            "text": "/* ==========================================\n   فرۆشگای ئێمە - Mobile Optimized CSS v3 Glass\n   ========================================== */\n/* style */\n:root {\n    --primary: #f97316;\n    --primary-dark: #ea580c;\n    --primary-light: #fb923c;\n    --secondary: #f43f5e;\n    --accent: #8b5cf6;\n    --success: #22c55e;\n    --bg-dark: #0f0f0f;\n    --bg-card: rgba(255, 255, 255, 0.07);\n    --glass: rgba(255, 255, 255, 0.08);\n    --text-primary: rgba(255,255,255,0.95);\n    --text-secondary: rgba(255,255,255,0.6);\n    --text-muted: rgba(255,255,255,0.4);\n    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);\n    --shadow-md: 0 8px 32px rgba(0, 0, 0, 0.25);\n    --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.35);\n    --radius-sm: 12px;\n    --radius-md: 16px;\n    --radius-lg: 20px;\n    --radius-xl: 24px;\n    --transition: all 0.3s ease;\n    --gradient-primary: linear-gradient(135deg, #f97316, #f43f5e);\n}\n \n*, *::before, *::after {\n    margin: 0; padding: 0;\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n}\n \nhtml { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }\n \nbody {\n    font-family: 'Noto Sans Arabic', -apple-system, BlinkMacSystemFont, sans-serif;\n    background: #0f0f0f;\n    color: var(--text-primary);\n    min-height: 100vh;\n    min-height: 100dvh;\n    direction: rtl;\n    overflow-x: hidden;\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n}\n\n.site-main {\n    display: block;\n}\n\nbutton:focus-visible,\na:focus-visible,\ninput:focus-visible {\n    outline: 2px solid rgba(249,115,22,0.55);\n    outline-offset: 2px;\n}\n \n/* ==========================================\n   Loading Screen\n   ========================================== */\n.loader {\n    position: fixed; inset: 0;\n    background: var(--bg-dark);\n    display: flex; align-items: center; justify-content: center;\n    z-index: 10000;\n    transition: opacity 0.4s, visibility 0.4s;\n}\n.loader.hidden { opacity: 0; visibility: hidden; }\n.loader-content { text-align: center; }\n.loader-icon {\n    width: 70px; height: 70px;\n    background: var(--gradient-primary);\n    border-radius: 20px;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 28px; color: white;\n    margin: 0 auto 16px;\n    animation: pulse 1.5s ease-in-out infinite;\n}\n.loader-text {\n    color: white; font-size: 22px; font-weight: 700;\n    background: var(--gradient-primary);\n    -webkit-background-clip: text; -webkit-text-fill-color: transparent;\n}\n.loader-bar {\n    width: 160px; height: 3px;\n    background: rgba(255,255,255,0.1);\n    border-radius: 2px; overflow: hidden;\n    margin: 16px auto 0;\n}\n.loader-progress {\n    height: 100%;\n    background: var(--gradient-primary);\n    animation: loading 1.5s ease forwards;\n}\n@keyframes loading { 0%{width:0%} 100%{width:100%} }\n@keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.05)} }\n \n/* ==========================================\n   Background\n   ========================================== */\n.bg-container { position: fixed; inset: 0; z-index: -1; overflow: hidden; }\n.gradient-bg { position: absolute; inset: 0; background: linear-gradient(135deg, #1a1a2e, #16213e, #0f0f23); }\n.floating-shapes { display: none; } /* ★ CPU خۆڵ */\n.shape {\n    position: absolute; border-radius: 50%;\n    filter: blur(40px); opacity: 0.35;\n    animation: none; /* ★ GPU بچووکتر */\n    will-change: auto;\n}\n.shape-1 { width:300px;height:300px;background:radial-gradient(circle,rgba(249,115,22,.35),transparent);top:-80px;right:-80px; }\n.shape-2 { width:260px;height:260px;background:radial-gradient(circle,rgba(244,63,94,.25),transparent);bottom:-40px;left:-80px; }\n.shape-3 { width:220px;height:220px;background:radial-gradient(circle,rgba(139,92,246,.2),transparent);top:45%;left:35%; }\n \n \n/* ==========================================\n   Navbar\n   ========================================== */\n.navbar { position: fixed; top: 8px; left: 8px; right: 8px; z-index: 1000; }\n.nav-container {\n    background: rgba(15,15,15,0.9);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    padding: 9px 12px;\n    display: flex; align-items: center;\n    justify-content: space-between; gap: 10px;\n    border: 1px solid rgba(255,255,255,0.08);\n    border-radius: 22px;\n    box-shadow: 0 12px 28px rgba(0,0,0,0.18);\n}\n.logo { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }\n.logo-icon {\n    width: 40px; height: 40px;\n    background: var(--gradient-primary);\n    border-radius: 11px;\n    display: flex; align-items: center; justify-content: center;\n    color: white; font-size: 18px;\n}\n.logo-text { display: none; flex-direction: column; }\n.logo-title { font-size: 14px; font-weight: 800; background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n.logo-subtitle { display: none; }\n \n.nav-search { display: none; position: relative; }\n.nav-search i { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 14px; }\n.nav-search input {\n    width: 100%; padding: 13px 42px 13px 14px;\n    background: rgba(255,255,255,0.045);\n    border: 1px solid rgba(255,255,255,0.09);\n    border-radius: 18px;\n    color: white; font-size: 14px; font-family: inherit;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);\n}\n.nav-search input:focus {\n    outline: none;\n    border-color: rgba(249,115,22,0.4);\n    background: rgba(255,255,255,0.06);\n}\n \n.mobile-search {\n    padding: 0 16px 14px;\n    position: sticky;\n    top: 70px;\n    z-index: 999;\n}\n.mobile-search-inner {\n    background: rgba(14,15,22,0.96);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border: 1px solid rgba(255,255,255,0.08);\n    border-radius: 18px;\n    display: flex; align-items: center; gap: 12px;\n    padding: 12px 16px;\n    box-shadow: 0 10px 26px rgba(0,0,0,0.16);\n}\n.mobile-search-inner i { color: var(--text-muted); font-size: 16px; flex-shrink: 0; }\n.mobile-search-inner input {\n    flex: 1; background: none; border: none;\n    color: white; font-size: 14px;\n    font-family: inherit; outline: none;\n    line-height: 1.4;\n}\n.mobile-search-inner input::placeholder { color: var(--text-muted); }\n\n.offline-banner {\n    margin: 0 auto;\n    padding: 0 16px;\n    max-height: 0;\n    opacity: 0;\n    overflow: hidden;\n    transform: translateY(-8px);\n    transition: max-height 0.28s ease, opacity 0.22s ease, transform 0.28s ease, margin 0.28s ease;\n}\n.offline-banner.visible {\n    max-height: 92px;\n    opacity: 1;\n    transform: translateY(0);\n    margin-bottom: 12px;\n}\n.offline-banner-inner {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 9px;\n    padding: 10px 12px;\n    border-radius: 14px;\n    background: linear-gradient(135deg, rgba(249,115,22,0.11), rgba(10,14,24,0.48));\n    border: 1px solid rgba(249,115,22,0.18);\n    color: #fee2c9;\n    box-shadow: 0 8px 18px rgba(0,0,0,0.14);\n}\n.offline-banner-inner i {\n    width: 28px;\n    height: 28px;\n    border-radius: 50%;\n    background: rgba(249,115,22,0.14);\n    color: var(--primary-light);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    font-size: 12px;\n}\n.offline-banner-inner span {\n    flex: 1;\n    min-width: 160px;\n    font-size: 12.5px;\n    font-weight: 650;\n    line-height: 1.5;\n}\n.offline-retry-btn {\n    min-height: 34px;\n    padding: 8px 14px;\n    border: 1px solid rgba(249,115,22,0.28);\n    border-radius: 999px;\n    background: rgba(249,115,22,0.16);\n    color: #fff7ed;\n    font-family: inherit;\n    font-size: 12px;\n    font-weight: 800;\n    cursor: pointer;\n    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;\n}\n.offline-retry-btn:hover,\n.offline-retry-btn:active {\n    transform: translateY(-1px);\n    background: rgba(249,115,22,0.26);\n    border-color: rgba(249,115,22,0.42);\n}\n \n.cart-btn {\n    display: flex; align-items: center; gap: 8px;\n    min-height: 46px;\n    padding: 11px 16px;\n    background: var(--gradient-primary);\n    border: none; border-radius: 18px;\n    color: white; font-family: inherit;\n    font-size: 14px; font-weight: 600;\n    cursor: pointer; position: relative; flex-shrink: 0;\n    transition: var(--transition);\n    box-shadow: 0 10px 24px rgba(249,115,22,0.22);\n}\n.cart-btn i { font-size: 16px; }\n.cart-btn.shake {\n    animation: cartShake 0.38s ease;\n}\n.cart-text { display: none; }\n.cart-count {\n    position: absolute; top: -6px; left: -6px;\n    min-width: 22px; height: 22px;\n    background: white; color: var(--primary);\n    border-radius: 50%; font-size: 11px; font-weight: 800;\n    display: flex; align-items: center; justify-content: center; padding: 0 5px;\n}\n@keyframes cartShake {\n    0%, 100% { transform: translateX(0); }\n    20% { transform: translateX(-3px) rotate(-2deg); }\n    40% { transform: translateX(4px) rotate(2deg); }\n    60% { transform: translateX(-3px) rotate(-1deg); }\n    80% { transform: translateX(3px) rotate(1deg); }\n}\n \n/* ==========================================\n   Hero\n   ========================================== */\n.hero { min-height: auto; padding: 48px 16px 36px; text-align: center; }\n.hero-content { width: 100%; max-width: 640px; margin: 0 auto; }\n.hero-badge {\n    display: inline-flex; align-items: center; gap: 6px;\n    padding: 7px 15px;\n    background: rgba(249,115,22,0.15);\n    border: 1px solid rgba(249,115,22,0.26);\n    border-radius: 999px; color: var(--primary-light);\n    font-size: 12.5px; font-weight: 700;\n    margin-bottom: 20px;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);\n    animation: fadeInUp 0.6s ease forwards; opacity: 0;\n}\n.hero-badge i { animation: spin 8s linear infinite; }\n@keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }\n.hero-title { font-size: 34px; font-weight: 900; line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 16px; animation: fadeInUp 0.6s ease 0.2s forwards; opacity: 0; }\n.title-line { display: block; color: white; margin-bottom: 3px; }\n.title-highlight { display: block; background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n.hero-subtitle {\n    max-width: 31ch;\n    margin: 0 auto 28px;\n    font-size: 15px;\n    color: rgba(255,255,255,0.64);\n    line-height: 1.8;\n    animation: fadeInUp 0.6s ease 0.4s forwards;\n    opacity: 0;\n}\n.hero-stats {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 18px;\n    width: fit-content;\n    max-width: 100%;\n    margin: 0 auto;\n    padding: 14px 18px;\n    border-radius: 20px;\n    background: rgba(255,255,255,0.03);\n    border: 1px solid rgba(255,255,255,0.06);\n    animation: fadeInUp 0.6s ease 0.6s forwards;\n    opacity: 0;\n}\n.stat-item { text-align: center; min-width: 72px; }\n.stat-number { display: block; font-size: 27px; line-height: 1; margin-bottom: 6px; font-weight: 800; background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n.stat-label { font-size: 11px; color: var(--text-muted); letter-spacing: 0.02em; }\n.stat-divider { width: 1px; height: 28px; background: rgba(255,255,255,0.08); }\n.hero-decoration { display: none; }\n@keyframes fadeInUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }\n \n/* ==========================================\n   Categories\n   ========================================== */\n.categories-section {\n    padding: 18px 16px;\n    background: rgba(0,0,0,0.18);\n    margin: 0 8px;\n    border-radius: var(--radius-xl);\n    border: 1px solid rgba(255,255,255,0.05);\n}\n.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\n.section-title { display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: 800; color: white; }\n.section-title i {\n    width: 36px; height: 36px;\n    background: rgba(249,115,22,0.2);\n    border-radius: var(--radius-md);\n    display: flex; align-items: center; justify-content: center;\n    font-size: 14px; color: var(--primary);\n}\n.products-count { font-size: 11px; font-weight: 700; color: var(--text-muted); padding: 7px 12px; background: rgba(255,255,255,0.08); border-radius: 999px; }\n \n.categories-container {\n    display: grid !important;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 12px;\n}\n \n.category-card {\n    background: rgba(255,255,255,0.045);\n    border: 1px solid rgba(255,255,255,0.1);\n    border-radius: 18px;\n    padding: 14px 12px;\n    display: flex !important;\n    flex-direction: row;\n    align-items: center;\n    gap: 12px;\n    cursor: pointer;\n    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;\n    text-align: right;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);\n}\n.category-card.active {\n    background: linear-gradient(135deg, rgba(249,115,22,0.16), rgba(244,63,94,0.05));\n    border-color: rgba(249,115,22,0.32);\n    box-shadow: 0 12px 26px rgba(249,115,22,0.12);\n}\n.category-card:active { transform: scale(0.975); }\n.category-icon {\n    width: 42px; height: 42px; flex-shrink: 0;\n    background: rgba(249,115,22,0.14);\n    border-radius: 14px;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 18px; color: var(--primary);\n    transition: var(--transition);\n}\n.category-card.active .category-icon { background: var(--gradient-primary); color: white; }\n.category-info { flex: 1; min-width: 0; }\n.category-name { display: block; font-size: 13.5px; font-weight: 700; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 2px; }\n.category-count { display: block; font-size: 10.5px; font-weight: 600; color: var(--text-muted); }\n \n/* ==========================================\n   Products - GLASS MORPHISM\n   ========================================== */\n.products-section { padding: 18px 16px 16px; }\n.products-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }\n\n.search-group {\n    grid-column: 1 / -1;\n}\n.search-group + .search-group {\n    margin-top: 4px;\n}\n.search-group-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    padding: 10px 2px 12px;\n    margin-bottom: 12px;\n    border-bottom: 1px solid rgba(255,255,255,0.08);\n}\n.search-group-title {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-width: 0;\n}\n.search-group-icon {\n    width: 34px;\n    height: 34px;\n    border-radius: 12px;\n    background: rgba(249,115,22,0.16);\n    color: var(--primary);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 14px;\n    flex-shrink: 0;\n}\n.search-group-name {\n    font-size: 14px;\n    font-weight: 800;\n    color: white;\n}\n.search-group-count {\n    padding: 6px 12px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.08);\n    color: var(--text-muted);\n    font-size: 11px;\n    font-weight: 700;\n    flex-shrink: 0;\n}\n\n/* کارتی کاڵا - گلاس مۆرفیزم */\n.product-card {\n    background: rgba(255, 255, 255, 0.055);\n    backdrop-filter: none;\n    -webkit-backdrop-filter: none;\n    border: 1px solid rgba(255, 255, 255, 0.11);\n    border-radius: 18px;\n    overflow: hidden;\n    position: relative;\n    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;\n    opacity: 1;                           /* ★ animation بسڕدرایەوە */\n    box-shadow:\n        0 8px 22px rgba(0, 0, 0, 0.16),\n        inset 0 1px 0 rgba(255, 255, 255, 0.06);\n}\n \n/* ★ cardAppear تەواو لابرا — contain/content-visibility بۆ renderی سبوک */\n.product-card {\n    contain: layout style paint;\n    content-visibility: auto;\n    contain-intrinsic-size: 320px 360px;\n}\n \n.product-card:active { transform: scale(0.985); }\n \n/* ڕەسمی کاڵا */\n.product-image {\n    position: relative;\n    height: 148px;\n    overflow: hidden;\n    cursor: zoom-in;\n    background: rgba(255,255,255,0.03);\n}\n.product-image picture {\n    display: block;\n    width: 100%;\n    height: 100%;\n}\n.product-image img {\n    width: 100%; height: 100%;\n    object-fit: cover;\n    transition: transform 0.36s ease, opacity 0.24s ease;\n}\n.product-card:hover img,\n.product-image:hover img { transform: scale(1.05); }\n \n.product-overlay {\n    position: absolute; inset: 0;\n    background: linear-gradient(180deg, rgba(6,9,20,0.12), rgba(6,9,20,0.46));\n    display: flex; align-items: center; justify-content: center;\n    opacity: 0; transition: opacity 0.2s ease;\n}\n.product-image:hover .product-overlay,\n.product-card:active .product-overlay { opacity: 1; }\n \n.product-badge {\n    position: absolute; top: 10px; right: 10px;\n    padding: 4px 10px;\n    background: var(--gradient-primary);\n    border-radius: 50px; color: white;\n    font-size: 10px; font-weight: 700;\n}\n \n/* ناوی کاڵا */\n.product-content {\n    padding: 13px 13px 12px;\n    background: linear-gradient(180deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.08));\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n}\n \n.product-name {\n    font-size: 14px;\n    font-weight: 700;\n    color: rgba(255, 255, 255, 0.95);\n    margin-bottom: 0;\n    line-height: 1.35;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n    min-height: 2.7em;\n}\n \n.product-desc {\n    font-size: 11px;\n    color: rgba(255, 255, 255, 0.45);\n    margin-bottom: 0;\n    line-height: 1.45;\n    display: -webkit-box;\n    -webkit-line-clamp: 1;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n}\n \n.product-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-top: auto;\n}\n \n.product-price { display: flex; flex-direction: column; }\n.price-label { font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.4); }\n.price-value {\n    font-size: 14px; line-height: 1.1; font-weight: 800;\n    background: var(--gradient-primary);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n \n/* دوگمەی زیادکردن بۆ سەبەتە */\n.add-btn {\n    width: 42px; height: 42px;\n    background: rgba(249, 115, 22, 0.12);\n    border: 1px solid rgba(249, 115, 22, 0.24);\n    border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    color: var(--primary);\n    font-size: 16px;\n    cursor: pointer;\n    transition: var(--transition);\n    flex-shrink: 0;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);\n}\n.add-btn:active,\n.add-btn:hover {\n    background: var(--gradient-primary);\n    border-color: transparent;\n    color: white;\n    transform: scale(0.95);\n    box-shadow: 0 8px 18px rgba(249,115,22,0.28);\n}\n \n/* کارتی overlay دوگمە */\n.add-btn-overlay {\n    padding: 10px 20px;\n    background: var(--gradient-primary);\n    border: none; border-radius: var(--radius-md);\n    color: white; font-family: inherit;\n    font-size: 14px; font-weight: 700;\n    cursor: pointer;\n    display: flex; align-items: center; gap: 6px;\n}\n \n.empty-state { text-align: center; padding: 40px 20px; }\n.empty-icon { width:70px;height:70px;background:rgba(249,115,22,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;color:var(--primary);margin:0 auto 16px; }\n.empty-state h3 { font-size: 18px; color: white; margin-bottom: 6px; }\n.empty-state p { color: var(--text-muted); font-size: 14px; }\n\n.product-card.skeleton-card {\n    pointer-events: none;\n    overflow: hidden;\n    background: rgba(255,255,255,0.045);\n    border-color: rgba(255,255,255,0.09);\n}\n.product-card.skeleton-card::after {\n    display: none;\n}\n.skeleton-card .product-image,\n.skeleton-card .product-content {\n    background: transparent;\n}\n.skeleton-block {\n    position: relative;\n    overflow: hidden;\n    border-radius: 12px;\n    background: rgba(255,255,255,0.07);\n}\n.skeleton-block::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, rgba(255,255,255,0.01), rgba(255,255,255,0.08), rgba(255,255,255,0.01));\n    transform: translateX(-100%);\n    animation: skeletonSweep 1.45s linear infinite;\n}\n.skeleton-image {\n    width: 100%;\n    height: 100%;\n    border-radius: 0;\n}\n.skeleton-title {\n    width: 72%;\n    height: 15px;\n    margin-bottom: 0;\n}\n.skeleton-desc {\n    width: 54%;\n    height: 12px;\n    margin-bottom: 0;\n}\n.skeleton-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n}\n.skeleton-price {\n    width: 68px;\n    height: 24px;\n}\n.skeleton-action {\n    width: 42px;\n    height: 42px;\n    border-radius: 50%;\n}\n@keyframes skeletonSweep {\n    100% { transform: translateX(100%); }\n}\n\n.pagination-wrap {\n    display: flex;\n    justify-content: center;\n    margin-top: 20px;\n}\n.pagination {\n    width: min(100%, 400px);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 6px;\n    padding: 6px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.04);\n    border: 1px solid rgba(255,255,255,0.08);\n    box-shadow: 0 10px 20px rgba(0,0,0,0.12);\n}\n.pagination-btn {\n    min-width: 92px;\n    min-height: 42px;\n    padding: 10px 12px;\n    border: 1px solid rgba(249,115,22,0.22);\n    border-radius: 999px;\n    background: rgba(249,115,22,0.12);\n    color: #fdba74;\n    font-family: inherit;\n    font-size: 12px;\n    font-weight: 800;\n    cursor: pointer;\n    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;\n    touch-action: manipulation;\n}\n.pagination-btn:hover,\n.pagination-btn:active {\n    background: rgba(249,115,22,0.22);\n    border-color: rgba(249,115,22,0.45);\n    color: #fff;\n    transform: translateY(-1px);\n}\n.pagination-btn[disabled] {\n    cursor: not-allowed;\n    opacity: 0.44;\n    transform: none;\n    background: rgba(255,255,255,0.03);\n    border-color: rgba(255,255,255,0.08);\n    color: rgba(255,255,255,0.42);\n}\n.pagination-status {\n    flex: 1;\n    min-width: 110px;\n    padding: 9px 10px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.04);\n    text-align: center;\n    font-size: 12px;\n    font-weight: 800;\n    color: white;\n    white-space: nowrap;\n}\n.pagination-status small {\n    display: block;\n    margin-top: 1px;\n    font-size: 9px;\n    font-weight: 600;\n    color: var(--text-muted);\n}\n\n.image-modal {\n    position: fixed;\n    inset: 0;\n    z-index: 9999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 16px;\n    background: rgba(6,9,18,0.78);\n    opacity: 0;\n    visibility: hidden;\n    transition: opacity 0.24s ease, visibility 0.24s ease;\n}\n.image-modal.is-visible {\n    visibility: visible;\n}\n.image-modal.is-open {\n    opacity: 1;\n}\n.image-modal-dialog {\n    position: relative;\n    width: min(100%, 760px);\n    max-height: 100%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n    transform: translateY(14px) scale(0.98);\n    transition: transform 0.28s ease;\n}\n.image-modal.is-open .image-modal-dialog {\n    transform: translateY(0) scale(1);\n}\n.image-modal-close {\n    position: absolute;\n    top: 14px;\n    left: 14px;\n    width: 40px;\n    height: 40px;\n    border: 1px solid rgba(255,255,255,0.12);\n    border-radius: 50%;\n    background: rgba(10,13,24,0.78);\n    color: white;\n    font-size: 17px;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: background 0.2s ease, transform 0.2s ease;\n    z-index: 2;\n    box-shadow: 0 8px 22px rgba(0,0,0,0.18);\n}\n.image-modal-close:hover,\n.image-modal-close:active {\n    background: rgba(249,115,22,0.9);\n    transform: scale(0.96);\n}\n.image-modal-stage {\n    width: 100%;\n    border-radius: 24px;\n    overflow: hidden;\n    background: linear-gradient(180deg, rgba(21,25,41,0.96), rgba(9,12,20,0.98));\n    border: 1px solid rgba(255,255,255,0.08);\n    box-shadow: 0 22px 44px rgba(0,0,0,0.28);\n}\n.image-modal-frame {\n    width: 100%;\n    min-height: min(66vh, 580px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 20px;\n}\n.image-modal-img {\n    width: auto;\n    max-width: 100%;\n    max-height: min(60vh, 540px);\n    border-radius: 16px;\n    object-fit: contain;\n    transform: scale(0.96);\n    opacity: 0;\n    transition: transform 0.28s ease, opacity 0.22s ease;\n    box-shadow: 0 16px 34px rgba(0,0,0,0.24);\n}\n.image-modal.is-open .image-modal-img {\n    transform: scale(1);\n}\n.image-modal.has-image .image-modal-img {\n    opacity: 1;\n}\n.image-modal-info {\n    width: min(100%, 620px);\n    padding: 12px 16px;\n    border-radius: 18px;\n    background: rgba(10,13,24,0.74);\n    border: 1px solid rgba(255,255,255,0.08);\n    text-align: center;\n    box-shadow: 0 12px 26px rgba(0,0,0,0.18);\n}\n.image-modal-name {\n    font-size: 16px;\n    font-weight: 800;\n    color: white;\n}\n.image-modal-desc {\n    margin-top: 5px;\n    font-size: 12.5px;\n    color: rgba(255,255,255,0.62);\n    line-height: 1.6;\n}\n.image-modal-price {\n    margin-top: 8px;\n    font-size: 14px;\n    font-weight: 800;\n    color: #fdba74;\n}\n \n/* ==========================================\n   Cart Sidebar\n   ========================================== */\n.cart-overlay { position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);opacity:0;visibility:hidden;transition:var(--transition);z-index:1500; }\n.cart-overlay.active { opacity:1;visibility:visible; }\n.cart-sidebar {\n    position: fixed; top:0;left:0;right:0;bottom:0;\n    width:100%;height:100%;height:100dvh;\n    background: linear-gradient(180deg,#1a1a2e,#0f0f23);\n    transform: translateY(100%);\n    transition: var(--transition);\n    z-index: 2000;\n    display: flex; flex-direction: column;\n}\n.cart-sidebar.active { transform: translateY(0); }\n.cart-header { padding:16px;background:rgba(255,255,255,0.03);border-bottom:1px solid rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:space-between;flex-shrink:0; }\n.cart-title { display:flex;align-items:center;gap:12px; }\n.cart-title-icon { width:44px;height:44px;background:var(--gradient-primary);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;font-size:18px;color:white; }\n.cart-title h3 { font-size:18px;color:white; }\n.cart-title span { font-size:12px;color:var(--text-muted); }\n.close-btn { width:40px;height:40px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:50%;color:white;font-size:16px;cursor:pointer; }\n.close-btn:active { background:var(--secondary); }\n \n.cart-items { flex:1;overflow-y:auto;padding:12px;-webkit-overflow-scrolling:touch; }\n.cart-empty { text-align:center;padding:40px 20px; }\n.empty-cart-icon { width:60px;height:60px;background:rgba(255,255,255,0.05);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--text-muted);margin:0 auto 14px; }\n.cart-empty h4 { font-size:16px;color:white;margin-bottom:4px; }\n.cart-empty p { color:var(--text-muted);font-size:13px; }\n \n.cart-item { background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:var(--radius-md);padding:12px;margin-bottom:10px; }\n.cart-item-header { display:flex;justify-content:space-between;align-items:center;margin-bottom:10px; }\n.cart-item-name { font-size:14px;font-weight:600;color:white; }\n.cart-item-remove { width:30px;height:30px;background:rgba(244,63,94,0.15);border:none;border-radius:8px;color:var(--secondary);font-size:12px;cursor:pointer; }\n.cart-item-remove:active { background:var(--secondary);color:white; }\n.cart-item-controls { display:flex;justify-content:space-between;align-items:center; }\n.qty-controls { display:flex;align-items:center;gap:10px; }\n.qty-btn { width:34px;height:34px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:white;font-size:16px;cursor:pointer; }\n.qty-btn:active { background:var(--primary);border-color:var(--primary); }\n.cart-item-qty { min-width:24px;text-align:center;font-size:15px;font-weight:700;color:white; }\n.cart-item-price { font-size:14px;font-weight:700;color:var(--primary); }\n \n.cart-footer { padding:16px;background:rgba(255,255,255,0.02);border-top:1px solid rgba(255,255,255,0.1);flex-shrink:0; }\n.cart-summary { margin-bottom:14px; }\n.summary-row { display:flex;justify-content:space-between;margin-bottom:8px;font-size:13px;color:var(--text-muted); }\n.summary-row.total { font-size:16px;color:white;padding-top:10px;border-top:1px dashed rgba(255,255,255,0.1); }\n.total-amount { font-size:20px;font-weight:800;background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent; }\n \n.customer-form { margin-bottom:14px; }\n.customer-form h4 { font-size:13px;color:var(--text-muted);margin-bottom:10px;display:flex;align-items:center;gap:6px; }\n.form-group { position:relative;margin-bottom:10px; }\n.form-group input { width:100%;padding:14px 14px 14px 40px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:var(--radius-md);color:white;font-size:15px;font-family:inherit; }\n.form-group input:focus { outline:none;border-color:var(--primary); }\n.input-icon { position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted); }\n \n.checkout-btn { width:100%;padding:16px;background:linear-gradient(135deg,#25D366,#128C7E);border:none;border-radius:var(--radius-lg);color:white;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:var(--transition); }\n.checkout-btn:active { transform:scale(0.98); }\n \n/* ==========================================\n   Success Modal\n   ========================================== */\n.success-modal {\n    position: fixed; inset: 0;\n    background: rgba(0,0,0,0.85);\n    backdrop-filter: blur(10px);\n    z-index: 5000;\n    display: flex; align-items: center; justify-content: center;\n    padding: 20px;\n    opacity: 0; visibility: hidden;\n    transition: var(--transition);\n}\n.success-modal.active { opacity: 1; visibility: visible; }\n.success-modal-box {\n    background: linear-gradient(135deg, #1a1a2e, #16213e);\n    border: 1px solid rgba(255,255,255,0.1);\n    border-radius: var(--radius-xl);\n    padding: 32px 24px;\n    text-align: center;\n    max-width: 320px; width: 100%;\n    transform: scale(0.8);\n    transition: var(--transition);\n}\n.success-modal.active .success-modal-box { transform: scale(1); }\n.success-icon {\n    width: 80px; height: 80px;\n    background: linear-gradient(135deg, #25D366, #128C7E);\n    border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 36px; color: white;\n    margin: 0 auto 20px;\n    animation: bounceIn 0.5s ease;\n}\n@keyframes bounceIn { 0%{transform:scale(0)} 60%{transform:scale(1.2)} 100%{transform:scale(1)} }\n.success-modal h3 { font-size: 22px; font-weight: 800; color: white; margin-bottom: 10px; }\n.success-modal p { font-size: 14px; color: var(--text-muted); line-height: 1.7; margin-bottom: 24px; }\n.success-close-btn {\n    width: 100%; padding: 14px;\n    background: var(--gradient-primary);\n    border: none; border-radius: var(--radius-lg);\n    color: white; font-family: inherit;\n    font-size: 15px; font-weight: 700;\n    cursor: pointer;\n}\n \n/* ==========================================\n   Toast\n   ========================================== */\n.toast-container { position:fixed;bottom:20px;left:16px;right:16px;z-index:3000;display:flex;flex-direction:column;align-items:center;gap:8px; }\n.toast { background:rgba(20,20,35,0.98);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.1);border-radius:var(--radius-md);padding:12px 18px;display:flex;align-items:center;gap:10px;box-shadow:var(--shadow-lg);animation:toastIn 0.3s ease forwards; }\n.toast.hide { animation:toastOut 0.3s ease forwards; }\n@keyframes toastIn { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }\n@keyframes toastOut { from{opacity:1;transform:translateY(0)} to{opacity:0;transform:translateY(-20px)} }\n.toast-icon { width:28px;height:28px;background:var(--success);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:12px; }\n.toast-message { color:white;font-size:13px;font-weight:500; }\n \n/* ==========================================\n   ★ Lang Switcher — KU / EN\n   ========================================== */\n.lang-switcher {\n    display: flex;\n    gap: 3px;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(255,255,255,0.1);\n    border-radius: 14px;\n    padding: 4px;\n    flex-shrink: 0;\n}\n.lang-btn {\n    min-width: 42px;\n    min-height: 34px;\n    padding: 0 10px;\n    background: transparent;\n    border: none;\n    border-radius: 11px;\n    color: rgba(255,255,255,0.45);\n    font-size: 11px;\n    font-weight: 800;\n    cursor: pointer;\n    font-family: inherit;\n    letter-spacing: 0.5px;\n    transition: all 0.2s ease;\n    line-height: 1;\n}\n.lang-btn:hover { color: rgba(255,255,255,0.8); }\n.lang-btn.active {\n    background: var(--gradient-primary);\n    color: white;\n    box-shadow: 0 2px 8px rgba(249,115,22,0.4);\n}\n.lang-btn:active { transform: scale(0.93); }\n \n/* Scroll Top */\n/* ==========================================\n   ★ Wishlist Button (on product image)\n   ========================================== */\n.wishlist-btn {\n    position: absolute;\n    top: 8px; left: 8px;\n    width: 34px; height: 34px;\n    background: rgba(0,0,0,0.52);\n    border: 1px solid rgba(255,255,255,0.08); border-radius: 50%;\n    color: rgba(255,255,255,0.8);\n    font-size: 13px; cursor: pointer;\n    display: flex; align-items: center; justify-content: center;\n    transition: var(--transition);\n    z-index: 2;\n}\n.wishlist-btn:hover, .wishlist-btn.active {\n    background: rgba(244,63,94,0.9);\n    color: white;\n    transform: scale(1.1);\n}\nbody.light-mode .wishlist-btn {\n    background: #ffffff;\n    border-color: var(--light-border);\n    color: var(--light-text-muted);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .wishlist-btn.active { background: rgba(244,63,94,0.85); color: white; }\n\n/* ==========================================\n   ★ Wishlist Filter Button\n   ========================================== */\n.wishlist-filter-btn {\n    display: flex; align-items: center; gap: 5px;\n    padding: 7px 14px;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(255,255,255,0.1);\n    border-radius: 50px;\n    color: rgba(255,255,255,0.5);\n    font-size: 13px; cursor: pointer;\n    transition: var(--transition);\n    font-family: inherit; flex-shrink: 0;\n}\n.wishlist-filter-btn:hover { border-color: rgba(244,63,94,0.4); color: #f43f5e; }\n.wishlist-filter-btn.active {\n    background: rgba(244,63,94,0.15);\n    border-color: rgba(244,63,94,0.5);\n    color: #f43f5e;\n}\n.wishlist-filter-count {\n    background: #f43f5e; color: white;\n    font-size: 10px; font-weight: 800;\n    padding: 1px 6px; border-radius: 50px;\n    min-width: 18px; text-align: center;\n    display: inline-block;\n}\nbody.light-mode .wishlist-filter-btn {\n    background: var(--light-surface);\n    border-color: var(--light-border);\n    color: var(--light-text-secondary);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .wishlist-filter-btn.active {\n    background: var(--light-accent-soft);\n    border-color: var(--light-accent-border);\n    color: #c2410c;\n}\n\n/* ==========================================\n   ★ PWA Install Banner\n   ========================================== */\n.install-banner {\n    position: fixed; bottom: 0; left: 0; right: 0;\n    z-index: 2200; padding: 12px 16px;\n    transform: translateY(100%);\n    transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1);\n}\n.install-banner.visible { transform: translateY(0); }\n.install-banner-inner {\n    display: flex; align-items: center; gap: 12px;\n    background: linear-gradient(135deg, rgba(249,115,22,0.97), rgba(234,88,12,0.97));\n    border-radius: var(--radius-xl);\n    padding: 14px 18px;\n    box-shadow: 0 8px 32px rgba(249,115,22,0.4);\n    border: 1px solid rgba(255,255,255,0.15);\n}\n.install-banner-icon {\n    width: 42px; height: 42px; flex-shrink: 0;\n    background: rgba(255,255,255,0.2);\n    border-radius: 12px;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 18px; color: white;\n}\n.install-banner-text { flex: 1; min-width: 0; }\n.install-banner-text span { display: block; color: white; font-weight: 700; font-size: 14px; }\n.install-banner-text small { color: rgba(255,255,255,0.8); font-size: 12px; }\n.install-banner-btn {\n    width: 40px; height: 40px; flex-shrink: 0;\n    background: rgba(255,255,255,0.2);\n    border: 1px solid rgba(255,255,255,0.3);\n    border-radius: 12px; color: white;\n    font-size: 15px; cursor: pointer;\n    display: flex; align-items: center; justify-content: center;\n    transition: var(--transition);\n}\n.install-banner-btn:active { background: rgba(255,255,255,0.35); transform: scale(0.95); }\n.install-banner-close {\n    background: none; border: none;\n    color: rgba(255,255,255,0.6);\n    font-size: 18px; cursor: pointer;\n    padding: 4px; flex-shrink: 0; line-height: 1;\n}\n.install-banner-close:hover { color: white; }\n\n.scroll-top { position:fixed;bottom:20px;right:16px;width:46px;height:46px;background:var(--gradient-primary);border:none;border-radius:50%;color:white;font-size:16px;cursor:pointer;opacity:0;visibility:hidden;transform:translateY(20px);transition:var(--transition);z-index:1000; }\n.scroll-top.visible { opacity:1;visibility:visible;transform:translateY(0); }\n.scroll-top:active { transform:scale(0.9); }\n \n/* Footer */\n.footer { background:linear-gradient(180deg,rgba(8,12,34,0.88),rgba(7,10,28,0.96));border-top:1px solid rgba(255,255,255,0.06);padding:36px 16px 42px;margin-top:38px; }\n.footer-content { text-align:center;max-width:1100px;margin:0 auto; }\n.footer-logo { display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:14px; }\n.footer-icon { width:42px;height:42px;background:var(--gradient-primary);border-radius:12px;display:flex;align-items:center;justify-content:center;color:white;font-size:17px;box-shadow:0 10px 24px rgba(249,115,22,.18); }\n.footer-logo span { font-size:22px;font-weight:900;background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent; }\n.footer-text { color:var(--text-muted);font-size:13px;line-height:1.7;max-width:34ch;margin:0 auto 18px; }\n.developer-card { display:flex;align-items:center;gap:16px;justify-content:space-between;margin:22px auto 20px;max-width:780px;padding:20px 22px;border-radius:26px;background:linear-gradient(135deg,rgba(255,255,255,.065),rgba(255,255,255,.025));border:1px solid rgba(255,255,255,.10);box-shadow:0 14px 30px rgba(0,0,0,.18);text-align:right; }\n.developer-card-icon { width:56px;height:56px;border-radius:18px;background:rgba(249,115,22,.14);border:1px solid rgba(249,115,22,.20);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:24px;flex-shrink:0; }\n.developer-card-text { flex:1;min-width:0;display:flex;flex-direction:column;gap:5px; }\n.developer-label { color:rgba(255,255,255,.65);font-size:12.5px;font-weight:600; }\n.developer-name { color:white;font-size:26px;line-height:1.08;letter-spacing:-0.02em; }\n.profile-link-text { display: none; }\n.profile-btn { min-height:50px;padding:12px 22px;border-radius:999px;background:var(--gradient-primary);color:#fff;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:800;box-shadow:0 12px 24px rgba(249,115,22,.2);white-space:nowrap; }\n.profile-btn:active { transform:scale(.98); }\n.developer-credit { margin-top: 16px;font-size: 12.5px;color: rgba(255,255,255,.82);font-weight: 700;letter-spacing: .24px; }\n.footer-social { display:flex;justify-content:center;gap:10px;margin-top:18px; }\n.social-link { width:44px;height:44px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:17px;text-decoration:none;transition:var(--transition); }\n.social-link:hover,.social-link:active { background:var(--gradient-primary); border-color:transparent; transform:translateY(-2px); }\n.footer-phone { margin-top:16px; display:flex; align-items:center; justify-content:center; gap:8px; color:var(--text-muted); font-size:15px; }\n.footer-phone i { color:var(--primary); }\n.footer-phone a { color:inherit; text-decoration:none; direction:ltr; }\n\n@media (max-width: 767px) {\n    .developer-card { flex-direction:column;align-items:stretch;text-align:center;padding:16px; }\n    .developer-card-icon { margin:0 auto; }\n    .developer-card-text { align-items:center; }\n    .profile-btn { width:100%; }\n    .nav-container,\n    .mobile-search-inner,\n    .install-banner-inner,\n    .toast,\n    .success-modal,\n    .cart-overlay {\n        backdrop-filter: none;\n        -webkit-backdrop-filter: none;\n    }\n    .nav-container {\n        box-shadow: 0 10px 22px rgba(0,0,0,0.16);\n    }\n    .mobile-search-inner {\n        box-shadow: 0 8px 18px rgba(0,0,0,0.12);\n    }\n    .product-card {\n        box-shadow: 0 8px 18px rgba(0,0,0,0.14);\n    }\n    .footer {\n        padding: 32px 16px 108px;\n    }\n    .pagination {\n        width: 100%;\n        max-width: 360px;\n        padding: 6px 7px;\n        gap: 6px;\n    }\n    .pagination-btn {\n        min-width: 0;\n        flex: 1;\n        padding: 10px 8px;\n    }\n    .pagination-status {\n        min-width: 96px;\n        font-size: 12px;\n    }\n    .image-modal {\n        padding: 12px;\n    }\n    .image-modal-frame {\n        min-height: min(60vh, 420px);\n        padding: 14px;\n    }\n    .image-modal-info {\n        padding: 11px 13px;\n    }\n    .image-modal-close {\n        top: 10px;\n        left: 10px;\n        width: 38px;\n        height: 38px;\n    }\n}\n\n/* ==========================================\n   Tablet 768px+\n   ========================================== */\n@media (min-width: 768px) {\n    .navbar { top:12px;left:16px;right:16px; }\n    .nav-container { padding:12px 18px; }\n    .logo-text { display:none; }\n    .nav-search { display:block;flex:1;max-width:360px;position:relative; }\n    .mobile-search { display:none; }\n    .offline-banner {\n        max-width: 1240px;\n        padding: 0 24px;\n    }\n    .offline-banner.visible {\n        margin-top: 88px;\n        margin-bottom: 8px;\n    }\n    .cart-text { display:inline; }\n    .hero { min-height:48vh;padding:104px 24px 40px; }\n    .hero-title { font-size:46px; }\n    .footer { padding:34px 24px 40px; }\n    .categories-section { margin:0 16px; }\n    .categories-container { grid-template-columns:repeat(3, 1fr);gap:12px; }\n    .category-card { flex-direction:column;text-align:center;padding:18px 12px; }\n    .category-icon { width:46px;height:46px; }\n    .products-section { padding:24px; }\n    .products-grid { grid-template-columns:repeat(3, 1fr);gap:16px; }\n    .product-image { height:164px; }\n    .cart-sidebar { width:420px;right:0;left:auto;border-radius:var(--radius-xl) 0 0 var(--radius-xl);transform:translateX(100%); }\n    .cart-sidebar.active { transform:translateX(0); }\n}\n \n/* ==========================================\n   Desktop 1024px+\n   ========================================== */\n@media (min-width: 1024px) {\n    .hero {\n        min-height: 52vh;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        text-align: center;\n        direction: rtl;\n        padding: 112px 40px 54px;\n        max-width: 1240px;\n        margin: 0 auto;\n    }\n    .hero-content { max-width: 680px; }\n    .hero-title { font-size: 58px; }\n    .hero-stats { justify-content: center; }\n    .hero-badge { margin: 0 auto 18px; }\n    .hero-decoration { display: none; }\n    .floating-card { position:absolute;background:rgba(255,255,255,0.05);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.1);border-radius:var(--radius-lg);padding:14px 20px;display:flex;align-items:center;gap:10px;color:white;font-weight:600;font-size:14px;white-space:nowrap; }\n    .floating-card i { font-size:20px;color:var(--primary); }\n    .card-1{top:20%;right:10%} .card-2{top:50%;left:5%;animation-delay:-2s} .card-3{bottom:15%;right:20%;animation-delay:-4s}\n    .categories-section,.products-section { padding:24px 40px;max-width:1240px;margin:0 auto; }\n    .categories-container { grid-template-columns:repeat(6, 1fr); }\n    .category-card { flex-direction:column;text-align:center; }\n    .products-grid { grid-template-columns:repeat(5, 1fr);gap:20px; }\n    .product-card:hover {\n        transform: translateY(-4px);\n        background: rgba(255, 255, 255, 0.075);\n        border-color: rgba(249,115,22,0.24);\n        box-shadow: 0 18px 34px rgba(0,0,0,0.22), 0 0 0 1px rgba(249,115,22,0.1);\n    }\n    .product-image { height: 184px; }\n}\n\n@media (min-width: 1280px) {\n    .hero {\n        justify-content: space-between;\n        text-align: right;\n        direction: rtl;\n    }\n    .hero-content { max-width: 540px; }\n    .hero-stats { justify-content: flex-start; }\n    .hero-badge { margin: 0 0 18px; }\n    .hero-decoration { display:block;position:relative;width:320px;height:320px;flex-shrink:0; }\n    @keyframes cardFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-15px)} }\n    .floating-card { animation: cardFloat 8s ease-in-out infinite; }\n}\n \n::-webkit-scrollbar { width:4px; }\n::-webkit-scrollbar-track { background:transparent; }\n::-webkit-scrollbar-thumb { background:rgba(249,115,22,0.3);border-radius:2px; }\n::selection { background:rgba(249,115,22,0.3);color:white; }\n \n/* ==========================================\n   ★ Chatbot Widget\n   ========================================== */\n#chatWidget { position:fixed; bottom:76px; left:16px; z-index:2000; }\n#chatToggleBtn {\n    width:52px; height:52px;\n    background:var(--gradient-primary);\n    border:none; border-radius:50%;\n    color:white; font-size:22px;\n    cursor:pointer; position:relative;\n    box-shadow:0 4px 20px rgba(249,115,22,0.4);\n    transition:transform 0.2s ease;\n    display:flex; align-items:center; justify-content:center;\n}\n#chatToggleBtn:active { transform:scale(0.92); }\n.chat-badge {\n    position:absolute; top:-4px; right:-4px;\n    width:18px; height:18px;\n    background:#f43f5e; border-radius:50%;\n    font-size:10px; font-weight:800; color:white;\n    display:flex; align-items:center; justify-content:center;\n}\n#chatBox {\n    position:absolute; bottom:64px; left:0;\n    width:300px; max-height:420px;\n    background:linear-gradient(135deg,#1a1a2e,#16213e);\n    border:1px solid rgba(255,255,255,0.1);\n    border-radius:20px; overflow:hidden;\n    flex-direction:column;\n    box-shadow:0 20px 60px rgba(0,0,0,0.5);\n}\n#chatHeader {\n    padding:12px 14px;\n    background:rgba(249,115,22,0.1);\n    border-bottom:1px solid rgba(255,255,255,0.08);\n    display:flex; align-items:center; justify-content:space-between;\n}\n#chatMessages {\n    flex:1; overflow-y:auto; padding:12px;\n    display:flex; flex-direction:column; gap:8px;\n    max-height:260px;\n}\n.chat-msg {\n    max-width:82%; padding:9px 12px;\n    border-radius:14px; font-size:13px; line-height:1.5;\n    word-break:break-word;\n}\n.bot-msg { background:rgba(255,255,255,0.07); color:white; align-self:flex-start; border-bottom-right-radius:4px; }\n.user-msg { background:var(--gradient-primary); color:white; align-self:flex-end; border-bottom-left-radius:4px; }\n.typing-indicator { display:flex; gap:4px; align-items:center; padding:10px 14px; }\n.typing-indicator span {\n    width:7px; height:7px; background:rgba(255,255,255,0.5);\n    border-radius:50%; animation:typingBounce 1s infinite;\n}\n.typing-indicator span:nth-child(2) { animation-delay:0.2s; }\n.typing-indicator span:nth-child(3) { animation-delay:0.4s; }\n@keyframes typingBounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }\n#chatInputArea {\n    padding:10px 12px;\n    border-top:1px solid rgba(255,255,255,0.08);\n    display:flex; gap:8px;\n}\n#chatInput {\n    flex:1; background:rgba(255,255,255,0.07);\n    border:1px solid rgba(255,255,255,0.1);\n    border-radius:10px; padding:9px 12px;\n    color:white; font-size:13px; font-family:inherit;\n}\n#chatInput:focus { outline:none; border-color:var(--primary); }\n#chatInputArea button {\n    width:36px; height:36px;\n    background:var(--gradient-primary);\n    border:none; border-radius:10px;\n    color:white; cursor:pointer; font-size:14px;\n    flex-shrink:0; display:flex; align-items:center; justify-content:center;\n}\n@media (max-width:360px) { #chatBox { width:260px; } }\n \n/* ★ Delivery Tracking Section */\n.tracking-section { padding:20px 16px; }\n.tracking-inner {\n    background:rgba(255,255,255,0.04);\n    border:1px solid rgba(255,255,255,0.08);\n    border-radius:20px; padding:20px;\n    text-align:center; max-width:480px; margin:0 auto;\n}\n.tracking-inner h3 { font-size:15px; color:white; margin-bottom:6px; }\n.tracking-inner p { font-size:13px; color:rgba(255,255,255,0.5); margin-bottom:14px; }\n.tracking-form { display:flex; gap:8px; }\n.tracking-form input {\n    flex:1; background:rgba(255,255,255,0.06);\n    border:1px solid rgba(255,255,255,0.1);\n    border-radius:12px; padding:12px 14px;\n    color:white; font-size:13px; font-family:inherit;\n}\n.tracking-form input:focus { outline:none; border-color:var(--primary); }\n.tracking-form button {\n    width:44px; height:44px;\n    background:var(--gradient-primary);\n    border:none; border-radius:12px;\n    color:white; cursor:pointer; font-size:15px;\n    flex-shrink:0;\n}\n \n/* ==========================================\n   Navbar Scrolled State\n   ========================================== */\n.navbar.scrolled .nav-container {\n    background: rgba(10,10,18,0.98);\n    box-shadow: 0 10px 22px rgba(0,0,0,0.18);\n}\nbody.light-mode .navbar.scrolled .nav-container {\n    background: rgba(255,255,255,1);\n    box-shadow: var(--light-shadow-sm);\n}\n\n/* ==========================================\n   ★ Theme Button + Light Mode\n   ========================================== */\n.theme-btn {\n    width: 38px; height: 38px;\n    background: rgba(255,255,255,0.07);\n    border: 1px solid rgba(255,255,255,0.12);\n    border-radius: 12px;\n    color: rgba(255,255,255,0.7);\n    font-size: 15px; cursor: pointer;\n    display: flex; align-items: center; justify-content: center;\n    transition: var(--transition); flex-shrink: 0;\n}\n.theme-btn:active { transform: scale(0.9); background: var(--gradient-primary); color: white; }\n \n/* ==========================================\n   لايت مۆد - سیستەمی ڕوون و یەکدەست\n   لێرەدا هەموو surface و text و border ی تایبەتی لايت مۆد\n   بە شێوەیەکی یەکسان کۆنترۆڵ دەکرێن\n   ========================================== */\nbody.light-mode {\n    --light-bg: #f5f2ec;\n    --light-bg-soft: #fbf8f3;\n    --light-surface: #ffffff;\n    --light-surface-soft: #fcfaf7;\n    --light-border: #e8e0d5;\n    --light-border-strong: #d8ccba;\n    --light-text: #18212f;\n    --light-text-secondary: #657184;\n    --light-text-muted: #95a0ae;\n    --light-accent-soft: #fff4e6;\n    --light-accent-border: #f7cf9d;\n    --light-accent-text: #9a3412;\n    --light-shadow-sm: 0 2px 6px rgba(0,0,0,0.05);\n    --light-shadow-md: 0 12px 30px rgba(15,23,42,0.08);\n    background: linear-gradient(180deg, #fbf8f3 0%, #f5f2ec 100%);\n    color: var(--light-text);\n}\n\n/* پاشبنەما: سپیی نەرم و بێ هەستی ساردی */\nbody.light-mode .bg-container {\n    opacity: 0.92;\n}\n\nbody.light-mode .gradient-bg {\n    background:\n        radial-gradient(circle at top right, rgba(249,115,22,0.10), transparent 28%),\n        radial-gradient(circle at top left, rgba(15,23,42,0.05), transparent 24%),\n        linear-gradient(180deg, #fbf8f3 0%, #f5f2ec 100%);\n}\n\n/* شکلە ئامراوەکان — لە light mode دەرکەون بەڵام تەنها لە مۆبایل */\nbody.light-mode .floating-shapes { display: none; }\n\n/* ناوبار: ڕوون، خاوێن، و بە کۆنتراستی باش */\nbody.light-mode .navbar {\n    top: 10px;\n    left: 10px;\n    right: 10px;\n}\nbody.light-mode .nav-container {\n    background: rgba(255,255,255,0.88);\n    border: 1px solid rgba(232,224,213,0.92);\n    border-radius: 24px;\n    box-shadow: 0 16px 38px rgba(15,23,42,0.08);\n}\nbody.light-mode .nav-search i { color: var(--light-text-muted); }\nbody.light-mode .mobile-search {\n    top: 84px;\n}\nbody.light-mode .mobile-search-inner {\n    background: rgba(255,255,255,0.9);\n    border: 1px solid rgba(232,224,213,0.92);\n    border-radius: 22px;\n    box-shadow: 0 14px 28px rgba(15,23,42,0.06);\n}\nbody.light-mode .offline-banner-inner {\n    background: var(--light-accent-soft);\n    border-color: var(--light-accent-border);\n    color: var(--light-accent-text);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .offline-banner-inner i {\n    background: rgba(249,115,22,0.1);\n    color: #c2410c;\n}\nbody.light-mode .offline-retry-btn {\n    background: rgba(249,115,22,0.12);\n    border-color: rgba(234,88,12,0.16);\n    color: #9a3412;\n}\nbody.light-mode .offline-retry-btn:hover,\nbody.light-mode .offline-retry-btn:active {\n    background: rgba(249,115,22,0.2);\n    border-color: rgba(234,88,12,0.24);\n    color: #7c2d12;\n}\nbody.light-mode .mobile-search-inner i { color: var(--light-text-muted); }\nbody.light-mode .mobile-search-inner input,\nbody.light-mode .nav-search input { color: var(--light-text); }\nbody.light-mode .mobile-search-inner input::placeholder,\nbody.light-mode .nav-search input::placeholder { color: var(--light-text-muted); }\nbody.light-mode .nav-search input {\n    background: rgba(255,255,255,0.96);\n    border: 1px solid var(--light-border);\n    color: var(--light-text);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.85);\n}\nbody.light-mode .nav-search input:focus {\n    border-color: var(--primary);\n    background: var(--light-surface);\n}\nbody.light-mode .mobile-search-inner:focus-within {\n    border-color: var(--primary);\n    box-shadow: 0 14px 28px rgba(249,115,22,0.10);\n}\nbody.light-mode .cart-btn,\nbody.light-mode .profile-btn {\n    background: linear-gradient(135deg, #f97316, #fb7185);\n    color: #ffffff;\n    box-shadow: 0 14px 26px rgba(249,115,22,0.18);\n}\nbody.light-mode .cart-btn:hover,\nbody.light-mode .profile-btn:hover {\n    background: linear-gradient(135deg, #ea580c, #f43f5e);\n}\n\n/* hero: سەرەتا حەسی پڕۆفێشناڵ و هێمنی لايت مۆد دروست دەکات */\nbody.light-mode .hero {\n    background:\n        radial-gradient(circle at top right, rgba(249,115,22,0.08), transparent 32%),\n        linear-gradient(180deg, #fffdf9 0%, #faf5ef 100%);\n    border: 1px solid rgba(232,224,213,0.95);\n    box-shadow: 0 18px 42px rgba(15,23,42,0.06);\n    border-radius: 30px;\n    margin: 0 8px 10px;\n    overflow: hidden;\n}\nbody.light-mode .hero-badge {\n    background: var(--light-accent-soft);\n    border-color: var(--light-accent-border);\n    color: #c2410c;\n}\nbody.light-mode .title-line { color: var(--light-text); }\nbody.light-mode .hero-subtitle { color: var(--light-text-secondary); }\nbody.light-mode .hero-stats {\n    background: rgba(255,255,255,0.9);\n    border: 1px solid var(--light-border);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .stat-label { color: var(--light-text-secondary); }\nbody.light-mode .stat-divider { background: var(--light-border); }\n\n/* بەشی category: لە background جیادەبێتەوە بە surfaceی ناسک */\nbody.light-mode .categories-section {\n    background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(250,245,239,0.96));\n    border: 1px solid rgba(232,224,213,0.95);\n    border-radius: 30px;\n    box-shadow: 0 18px 38px rgba(15,23,42,0.06);\n}\nbody.light-mode .section-title { color: var(--light-text); }\nbody.light-mode .section-title i {\n    background: var(--light-accent-soft);\n    border: 1px solid var(--light-accent-border);\n    color: var(--primary);\n}\nbody.light-mode .products-count {\n    color: var(--light-text-secondary);\n    background: var(--light-surface-soft);\n    border: 1px solid var(--light-border);\n}\n\n/* کارتی category: active و inactive بە ئاشکرا جیادەکرێنەوە */\nbody.light-mode .category-card {\n    background: linear-gradient(180deg, #ffffff, #fcfaf7);\n    border: 1px solid rgba(232,224,213,0.95);\n    box-shadow: 0 12px 24px rgba(15,23,42,0.05);\n}\nbody.light-mode .category-card:hover {\n    background: linear-gradient(180deg, #ffffff, #fff8ef);\n    border-color: var(--light-border-strong);\n    box-shadow: 0 16px 30px rgba(15,23,42,0.08);\n    transform: translateY(-2px);\n}\nbody.light-mode .category-card.active {\n    background: linear-gradient(180deg, #fffdf8, #fff1dc);\n    border-color: rgba(249,115,22,0.38);\n    box-shadow: 0 16px 32px rgba(249,115,22,0.14);\n}\nbody.light-mode .category-name { color: var(--light-text); font-weight: 700; }\nbody.light-mode .category-count { color: var(--light-text-secondary); }\nbody.light-mode .category-icon {\n    background: var(--light-accent-soft);\n    border: 1px solid var(--light-accent-border);\n    color: var(--primary);\n}\nbody.light-mode .category-card.active .category-icon {\n    background: var(--gradient-primary);\n    color: #fff;\n}\n\n/* بەشی product grid پاشبنەمای ناسک دەمێنێت */\nbody.light-mode .products-section {\n    background: linear-gradient(180deg, rgba(255,255,255,0.46), rgba(255,255,255,0.22));\n    border: 1px solid rgba(232,224,213,0.78);\n    border-radius: 30px;\n    box-shadow: 0 16px 34px rgba(15,23,42,0.04);\n    margin: 8px 8px 0;\n}\n\n/* کارتەکانی کاڵا: کۆنتراست و خوێندنەوەی باش لە لايت مۆددا */\nbody.light-mode .product-card {\n    background: linear-gradient(180deg, #ffffff, #fcfaf7);\n    border: 1px solid rgba(232,224,213,0.95);\n    box-shadow: 0 14px 30px rgba(15,23,42,0.07);\n    backdrop-filter: none;\n    -webkit-backdrop-filter: none;\n}\nbody.light-mode .product-card:hover {\n    box-shadow: 0 18px 40px rgba(15,23,42,0.10);\n    border-color: var(--light-border-strong);\n    transform: translateY(-5px);\n}\nbody.light-mode .product-card.skeleton-card {\n    background: var(--light-surface);\n    border-color: var(--light-border);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .product-image {\n    background: linear-gradient(180deg, #faf7f2, #f1ece5);\n    border-bottom: 1px solid rgba(232,224,213,0.85);\n}\nbody.light-mode .product-content {\n    background: linear-gradient(180deg, #ffffff, #fdfbf8);\n}\nbody.light-mode .product-name { color: var(--light-text); }\nbody.light-mode .product-desc { color: var(--light-text-secondary); }\nbody.light-mode .price-label { color: var(--light-text-muted); }\nbody.light-mode .price-value {\n    background: none;\n    -webkit-text-fill-color: currentColor;\n    color: #ea580c;\n}\nbody.light-mode .search-group-header { border-bottom-color: var(--light-border); }\nbody.light-mode .search-group-icon {\n    background: var(--light-accent-soft);\n    border: 1px solid var(--light-accent-border);\n    color: #ea580c;\n}\nbody.light-mode .search-group-name { color: var(--light-text); }\nbody.light-mode .search-group-count {\n    background: var(--light-surface-soft);\n    border: 1px solid var(--light-border);\n    color: var(--light-text-secondary);\n}\nbody.light-mode .skeleton-block {\n    background: #eef1f4;\n}\nbody.light-mode .skeleton-block::before {\n    background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.8), rgba(255,255,255,0));\n}\nbody.light-mode .pagination {\n    background: rgba(255,255,255,0.72);\n    border-color: rgba(232,224,213,0.9);\n    box-shadow: 0 12px 28px rgba(15,23,42,0.05);\n}\nbody.light-mode .pagination-btn {\n    background: linear-gradient(180deg, #ffffff, #fcfaf7);\n    border-color: var(--light-border);\n    color: var(--light-text);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .pagination-btn:hover,\nbody.light-mode .pagination-btn:active {\n    background: #f3f4f6;\n    border-color: var(--light-border-strong);\n    color: var(--light-text);\n}\nbody.light-mode .pagination-btn[disabled] {\n    background: #f7f4ef;\n    border-color: var(--light-border);\n    color: var(--light-text-muted);\n    box-shadow: none;\n    opacity: 1;\n}\nbody.light-mode .pagination-status {\n    color: #c2410c;\n    background: var(--light-accent-soft);\n    border: 1px solid var(--light-accent-border);\n}\nbody.light-mode .pagination-status small {\n    color: var(--light-accent-text);\n}\nbody.light-mode .add-btn {\n    background: linear-gradient(180deg, #fffaf3, #fff1df);\n    border-color: var(--light-accent-border);\n    color: var(--primary);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .add-btn:hover,\nbody.light-mode .add-btn:active {\n    background: #f97316;\n    color: #fff;\n    border-color: transparent;\n}\nbody.light-mode .product-overlay { background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(17,24,39,0.12)); }\n\n/* empty state: لە کاتی بەتاڵبوونیشدا UI ڕوون دەمێنێت */\nbody.light-mode .empty-state h3 { color: var(--light-text); }\nbody.light-mode .empty-state p { color: var(--light-text-secondary); }\nbody.light-mode .empty-icon { background: var(--light-accent-soft); }\n\n/* سەبەتە و sidebar: هەموو زانیارییەکان بە خوێندنەوەی باش */\nbody.light-mode .cart-sidebar {\n    background: linear-gradient(180deg, #ffffff, #f7f7f9);\n    border-left: 1px solid var(--light-border);\n}\nbody.light-mode .cart-header {\n    background: rgba(255,255,255,0.96);\n    border-bottom: 1px solid var(--light-border);\n}\nbody.light-mode .cart-title-icon { box-shadow: var(--light-shadow-sm); }\nbody.light-mode .cart-title h3 { color: var(--light-text); }\nbody.light-mode .cart-title span { color: var(--light-text-secondary); }\nbody.light-mode .close-btn {\n    background: var(--light-surface);\n    border-color: var(--light-border);\n    color: var(--light-text-secondary);\n}\nbody.light-mode .cart-item-remove {\n    background: #fff1f2;\n    border: 1px solid #fecdd3;\n    color: #e11d48;\n}\nbody.light-mode .cart-item-remove:active {\n    background: #ffe4e6;\n    color: #be123c;\n}\nbody.light-mode .cart-item {\n    background: var(--light-surface);\n    border: 1px solid var(--light-border);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .cart-item-name { color: var(--light-text); }\nbody.light-mode .cart-item-qty { color: var(--light-text); }\nbody.light-mode .qty-btn {\n    background: var(--light-surface);\n    border: 1px solid var(--light-border);\n    color: var(--light-text);\n}\nbody.light-mode .cart-empty h4 { color: var(--light-text); }\nbody.light-mode .cart-empty p { color: var(--light-text-secondary); }\nbody.light-mode .empty-cart-icon { background: var(--light-surface-soft); color: #d97706; }\nbody.light-mode .cart-footer {\n    background: rgba(255,255,255,0.86);\n    border-top: 1px solid var(--light-border);\n}\nbody.light-mode .summary-row span { color: var(--light-text-secondary); }\nbody.light-mode .summary-row.total span:first-child { color: var(--light-text); font-weight: 700; }\nbody.light-mode .summary-row.total { border-top-color: var(--light-border); }\nbody.light-mode .form-group input {\n    background: var(--light-surface-soft);\n    border: 1px solid var(--light-border);\n    color: var(--light-text);\n}\nbody.light-mode .form-group input:focus { border-color: var(--primary); background: var(--light-surface); }\nbody.light-mode .input-icon { color: var(--light-text-muted); }\nbody.light-mode .customer-form h4 { color: var(--light-text-secondary); }\nbody.light-mode .cart-overlay { background: rgba(120,60,20,0.25); }\n\n/* modal و overlay: panel ڕوون بێت بەڵام focus لەسەر ناوەڕۆک بمێنێت */\nbody.light-mode .success-modal-box {\n    background: linear-gradient(135deg, #ffffff, #f9fafb);\n    border: 1px solid var(--light-border);\n    box-shadow: var(--light-shadow-md);\n}\nbody.light-mode .success-modal h3 { color: var(--light-text); }\nbody.light-mode .success-modal p { color: var(--light-text-secondary); }\nbody.light-mode .success-close-btn { box-shadow: var(--light-shadow-sm); }\nbody.light-mode .image-modal {\n    background: rgba(17,24,39,0.16);\n}\nbody.light-mode .image-modal-stage {\n    background: linear-gradient(180deg, #ffffff, #f9fafb);\n    border-color: var(--light-border);\n    box-shadow: var(--light-shadow-md);\n}\nbody.light-mode .image-modal-info {\n    background: rgba(255,255,255,0.96);\n    border-color: var(--light-border);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .image-modal-name { color: var(--light-text); }\nbody.light-mode .image-modal-desc { color: var(--light-text-secondary); }\nbody.light-mode .image-modal-price { color: #c2410c; }\nbody.light-mode .image-modal-close {\n    background: rgba(255,255,255,0.96);\n    border-color: var(--light-border);\n    color: var(--light-text);\n}\n\n/* toast و tracking بۆ ڕاگەیاندن و دۆخی سیستەم */\nbody.light-mode .toast {\n    background: rgba(255,255,255,0.98);\n    border: 1px solid var(--light-border);\n    box-shadow: var(--light-shadow-md);\n}\nbody.light-mode .toast-message { color: var(--light-text); }\n\n/* Tracking */\nbody.light-mode .tracking-inner {\n    background: var(--light-surface);\n    border: 1px solid var(--light-border);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .tracking-inner h3 { color: var(--light-text); }\nbody.light-mode .tracking-inner p { color: var(--light-text-secondary); }\nbody.light-mode .tracking-form input {\n    background: var(--light-surface-soft);\n    border: 1px solid var(--light-border);\n    color: var(--light-text);\n}\n\n/* footer: کۆتاییەکی پاک و متمانەپێکراو بۆ ماڵپەڕ */\nbody.light-mode .footer {\n    background: linear-gradient(180deg, #f7f2eb, #f2ede5);\n    border-top: 1px solid rgba(220,210,197,0.95);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.72);\n}\nbody.light-mode .footer-logo span { background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\nbody.light-mode .footer-text { color: var(--light-text-secondary); }\nbody.light-mode .footer-phone { color: var(--light-text-secondary); }\nbody.light-mode .developer-credit { color: var(--light-text-secondary); }\nbody.light-mode .developer-label { color: var(--light-text-secondary); }\nbody.light-mode .developer-name { color: var(--light-text); }\nbody.light-mode .developer-card {\n    background: linear-gradient(135deg, #ffffff, #faf6ef);\n    border: 1px solid rgba(232,224,213,0.95);\n    box-shadow: 0 18px 36px rgba(15,23,42,0.08);\n}\nbody.light-mode .developer-card-icon {\n    background: var(--light-accent-soft);\n    border-color: var(--light-accent-border);\n    color: var(--primary);\n}\nbody.light-mode .social-link {\n    background: linear-gradient(180deg, #ffffff, #fcfaf7);\n    border: 1px solid var(--light-border);\n    color: var(--light-text-secondary);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .social-link:hover { background: var(--gradient-primary); color: #fff; border-color: transparent; }\n\n/* دوگمەکانی theme/lang و elementە هەڵواسراوەکان */\nbody.light-mode .lang-switcher {\n    background: rgba(255,255,255,0.84);\n    border-color: rgba(232,224,213,0.92);\n    box-shadow: 0 10px 20px rgba(15,23,42,0.05);\n}\nbody.light-mode .lang-btn { color: var(--light-text-secondary); }\nbody.light-mode .lang-btn.active { background: var(--gradient-primary); color: #fff; }\nbody.light-mode .theme-btn {\n    background: linear-gradient(180deg, #ffffff, #fcfaf7);\n    border-color: rgba(232,224,213,0.95);\n    color: var(--light-text-secondary);\n    box-shadow: var(--light-shadow-sm);\n}\nbody.light-mode .scroll-top { background: var(--gradient-primary); color: #fff; }\nbody.light-mode .profile-link-text { display: none; }\nbody.light-mode .install-banner-inner {\n    box-shadow: var(--light-shadow-md);\n}\nbody.light-mode .install-banner-btn {\n    background: rgba(255,255,255,0.22);\n}\nbody.light-mode .install-banner-close {\n    color: rgba(255,255,255,0.78);\n}\n\n/* لە شاشەی گەورەتر hero لە widthی ئاسایی خۆی دەمێنێت */\n@media (min-width: 768px) {\n    body.light-mode .navbar {\n        top: 14px;\n        left: 16px;\n        right: 16px;\n    }\n\n    body.light-mode .hero {\n        margin: 0 16px 12px;\n    }\n\n    body.light-mode .products-section {\n        margin: 12px 16px 0;\n    }\n}\n\n@media (min-width: 1024px) {\n    body.light-mode .hero {\n        margin: 0 auto 12px;\n    }\n\n    body.light-mode .products-section {\n        margin: 12px auto 0;\n    }\n}\n \n/* ==========================================\n   ★ LTR (English) overrides — navbar دەست نادەدرێت\n   ========================================== */\nhtml[lang=\"en\"] .cart-sidebar { right: auto; left: 0; border-radius: 0 var(--radius-xl) var(--radius-xl) 0; transform: translateX(-100%); }\nhtml[lang=\"en\"] .cart-sidebar.active { transform: translateX(0); }\nhtml[lang=\"en\"] .cart-header { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .cart-title { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .cart-item-header { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .cart-item-controls { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .product-footer { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .product-content { text-align: left; }\nhtml[lang=\"en\"] .categories-container { direction: ltr; }\nhtml[lang=\"en\"] .hero { text-align: center; direction: ltr; }\nhtml[lang=\"en\"] .hero-content {\n    width: 100%;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\nhtml[lang=\"en\"] .hero-title,\nhtml[lang=\"en\"] .hero-subtitle {\n    text-align: center;\n}\nhtml[lang=\"en\"] .hero-subtitle {\n    max-width: 34ch;\n}\nhtml[lang=\"en\"] .hero-stats { justify-content: center; direction: ltr; }\nhtml[lang=\"en\"] .hero-badge { direction: ltr; }\nhtml[lang=\"en\"] .section-header { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .products-section { direction: ltr; }\nhtml[lang=\"en\"] .mobile-search-inner { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .offline-banner-inner { direction: ltr; }\nhtml[lang=\"en\"] .form-group input { text-align: left; padding: 14px 14px 14px 40px; }\nhtml[lang=\"en\"] .input-icon { left: auto; right: 14px; }\nhtml[lang=\"en\"] .cart-count { left: auto; right: -6px; }\nhtml[lang=\"en\"] .wishlist-btn { left: auto; right: 8px; }\nhtml[lang=\"en\"] .summary-row { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .checkout-btn { flex-direction: row-reverse; }\nhtml[lang=\"en\"] .cart-footer { direction: ltr; text-align: left; }\nhtml[lang=\"en\"] .footer-content { direction: ltr; }\nhtml[lang=\"en\"] .toast { direction: ltr; }\nhtml[lang=\"en\"] .pagination { direction: ltr; }\nhtml[lang=\"en\"] .image-modal-close { left: auto; right: 10px; }\nhtml[lang=\"en\"] .image-modal-info { direction: ltr; }\n@media (min-width: 768px) {\n    html[lang=\"en\"] .cart-sidebar { width: 420px; left: 0; right: auto; border-radius: 0 var(--radius-xl) var(--radius-xl) 0; transform: translateX(-100%); }\n    html[lang=\"en\"] .cart-sidebar.active { transform: translateX(0); }\n}\n@media (min-width: 1280px) {\n    html[lang=\"en\"] .hero {\n        display: grid;\n        place-items: center;\n        text-align: center;\n    }\n    html[lang=\"en\"] .hero-content {\n        width: min(100%, 680px);\n        max-width: 680px;\n        margin: 0 auto;\n    }\n    html[lang=\"en\"] .hero-stats {\n        justify-content: center;\n    }\n    html[lang=\"en\"] .hero-badge {\n        margin: 0 auto 16px;\n    }\n    html[lang=\"en\"] .hero-decoration {\n        display: none;\n    }\n}\n\n@media (prefers-reduced-motion: reduce) {\n    *,\n    *::before,\n    *::after {\n        animation-duration: 0.01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 0.01ms !important;\n        scroll-behavior: auto !important;\n    }\n\n    .product-card:hover,\n    .category-card:hover,\n    .pagination-btn:hover,\n    .social-link:hover,\n    .profile-btn:hover,\n    .image-modal-close:hover {\n        transform: none !important;\n    }\n}\n\n/* Footer/profile enhancements v2026040803 */\n\n@media (min-width:768px) {\n    .nav-container { gap:14px; }\n    .theme-btn { order:4; }\n    .lang-switcher { order:5; }\n}\n\nhtml[lang=\"en\"] .developer-card { text-align:left; }\nhtml[lang=\"en\"] .developer-card-text { align-items:flex-start; }\nhtml[lang=\"en\"] .footer-phone { direction:ltr; }\nhtml[lang=\"en\"] .footer-logo,\nhtml[lang=\"en\"] .footer-social { direction:ltr; }\n"
